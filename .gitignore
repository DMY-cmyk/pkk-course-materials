# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Rust build artifacts
Dev Assistant/target/

# OS
.DS_Store
Thumbs.db

# Superpowers temp files
.superpowers/

# Git worktrees (isolated workspaces created by superpowers:using-git-worktrees)
.worktrees/

# Node (if ever needed)
node_modules/

# Logs
*.log

# Claude Code local settings (machine-specific) — ignore contents but
# allow specific files (use .claude/* instead of .claude/ so negations
# below work; git cannot re-include files inside an excluded directory)
.claude/*
# ...but track project-shared Winston framework reference
!.claude/winston-framework.md

# Large binary reference files — never commit
*.pdf
*.xlsx
*.png

# Pipeline-generated output (rendered by devassist, not tracked in git)
course-materials/outputs/
.superpowers/

# Fidelity verification PNG artifacts (generated by analysis/verify_pert11_fidelity.py)
analysis/_pert11_fidelity/
